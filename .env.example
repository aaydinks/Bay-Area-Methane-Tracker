# Copy to .env and fill in. Never commit .env.
CARBON_MAPPER_API_KEY=
# Census Data API key (free) for population context
CENSUS_API_KEY=
# Copernicus Data Space Ecosystem (Sentinel-2 L1C)
CDSE_USER=
CDSE_PASSWORD=
# NASA Earthdata: a user token (urs.earthdata.nasa.gov > Generate Token) for EMIT files,
# or the login in ~/.netrc (machine urs.earthdata.nasa.gov).
EARTHDATA_TOKEN=
# ERA5 via cdsapi reads ~/.cdsapirc.
# Publishing to the website's database (`mw publish push`): the Supabase session pooler
# connection string, which carries the database password. Never the publishable key.
SUPABASE_DB_URL=
# Optional Cloudflare Pages deploy hooks, called after `mw publish set-visibility`.
CF_DEPLOY_HOOK_REVIEW=
CF_DEPLOY_HOOK_PUBLIC=
