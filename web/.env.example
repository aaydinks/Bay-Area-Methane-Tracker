# Copy to web/.env for local work. Never commit .env.
#
# What the site shows: "review" includes restricted rows and review-visibility publications and
# needs the secret key; "public" shows public, unrestricted rows only and refuses a secret key.
SITE_MODE=review
# Where data comes from: "fixture" (web/fixtures/snapshot.json, no keys) or "supabase".
DATA_SOURCE=fixture
# Supabase project. The publishable key is safe to expose; the secret key never is.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# The site's public address, used for canonical and share links.
SITE_URL=http://localhost:4321
