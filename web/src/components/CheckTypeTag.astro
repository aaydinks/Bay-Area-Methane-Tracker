---
import Icon from './Icon.astro';
import { CHECK_TYPE } from '../config';
import { checkLabel } from '../lib/data';
// The kind of record, naming its regulator when the landfill's air district is known.
interface Props { type: string | null | undefined; repairKind?: string | null; siteId?: string | null }
const { type, repairKind, siteId } = Astro.props;
const info = CHECK_TYPE[type ?? 'other'] ?? CHECK_TYPE.other;
---
<span class="tag"><Icon name={info.icon} /> {checkLabel(type, siteId)}{repairKind ? ` (${repairKind})` : ''}</span>
