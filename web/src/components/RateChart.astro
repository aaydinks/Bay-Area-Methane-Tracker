---
// Dot-and-whisker chart of one rate per method with its 90% range, on a linear scale.
// Labels are plain text: an image must not hold links. The table beside it has the numbers.
import { num } from '../lib/format';
interface Item { label: string; value: number; lo: number; hi: number; highlight?: boolean }
interface Props { items: Item[]; title: string; unit: 'percent' | 'count' }
const { items, title, unit } = Astro.props;
const width = 720, left = 250, right = 30, rowH = 34, top = 20, bottom = 36;
const height = top + bottom + items.length * rowH;
const scale = unit === 'percent' ? 100 : 1;
const maxV = Math.max(...items.map((i) => i.hi)) * scale;
const step = unit === 'percent' ? (maxV > 50 ? 20 : maxV > 20 ? 10 : 5) : maxV > 4 ? 1 : 0.5;
const end = Math.max(step, Math.ceil(maxV / step) * step);
const x = (v: number) => left + ((v * scale) / end) * (width - left - right);
const ticks: number[] = [];
for (let t = 0; t <= end + 1e-9; t += step) ticks.push(t);
const fmt = (v: number) => (unit === 'percent' ? `${(v * 100).toFixed(1)}%` : num(v));
const summary = items.map((i) => `${i.label}: ${fmt(i.value)}, 90% range ${fmt(i.lo)} to ${fmt(i.hi)}`).join('; ');
---
<figure class="chart">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`${title}. ${summary}.`}>
    <line class="axis" x1={left} x2={width - right} y1={height - bottom} y2={height - bottom} />
    {ticks.map((t) => (
      <g>
        <line class="grid" x1={x(t / scale)} x2={x(t / scale)} y1={top - 6} y2={height - bottom} />
        <text class="tick" x={x(t / scale)} y={height - bottom + 16} text-anchor="middle">{unit === 'percent' ? `${t}%` : num(t)}</text>
      </g>
    ))}
    {items.map((i, k) => {
      const y = top + k * rowH + rowH / 2;
      return (
        <g>
          <title>{`${i.label}: ${fmt(i.value)} (90% range ${fmt(i.lo)} to ${fmt(i.hi)})`}</title>
          <text class:list={['label', { strong: i.highlight }]} x={left - 10} y={y + 4} text-anchor="end">{i.label}</text>
          <line class:list={['whisker', { highlight: i.highlight }]} x1={x(i.lo)} x2={x(i.hi)} y1={y} y2={y} />
          <circle class:list={['dot', { highlight: i.highlight }]} cx={x(i.value)} cy={y} r="6" />
        </g>
      );
    })}
  </svg>
  <figcaption>{title}. The dot is the value on the held-out patches and the line its 90% range.</figcaption>
</figure>

<style>
  /* The model is in the accent colour and bold; the methods it is compared with are muted */
  .label.strong { font-weight: 700; }
  .whisker:not(.highlight) { stroke: var(--muted); }
  .dot:not(.highlight) { fill: var(--muted); }
</style>
