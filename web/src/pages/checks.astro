---
import '../styles/checks.css';
import Base from '../layouts/Base.astro';
import EmptyState from '../components/EmptyState.astro';
import ChecksTable, { type CheckRow } from '../islands/ChecksTable';
import { CHECK_TYPE, DATE_CONFIDENCE, EVIDENCE, EXPECTED, RESULT, type ResultColour } from '../config';
import { siteName, snapshot } from '../lib/data';
import { date } from '../lib/format';

const rows: CheckRow[] = [...snapshot.checks]
  .sort((a, b) => (b.date_start ?? '').localeCompare(a.date_start ?? ''))
  .map((c) => {
    const colour = (c.result_held ? 'grey' : c.colour ?? 'grey') as ResultColour;
    const badge = c.result_held ? 'Result held back' : c.colour ? RESULT[colour].label : 'Not yet tested';
    return {
      id: c.check_id ?? '',
      date: c.date_start ?? '',
      dateLabel: date(c.date_start),
      dateConfidence: DATE_CONFIDENCE[c.date_confidence ?? ''] ?? c.date_confidence ?? '',
      site: siteName(c.site_id),
      siteHref: `/sites/${c.site_id}/`,
      typeLabel: CHECK_TYPE[c.check_type ?? 'other']?.label ?? 'Record',
      typeIcon: CHECK_TYPE[c.check_type ?? 'other']?.icon ?? 'dot',
      repairKind: c.repair_kind ?? null,
      colour,
      badge,
      call: c.call ?? null,
      changeMed: c.change_pct_med ?? null,
      changeLo: c.change_pct_lo ?? null,
      changeHi: c.change_pct_hi ?? null,
      deMed: c.de_t_yr_med ?? null,
      deLo: c.de_t_yr_lo ?? null,
      deHi: c.de_t_yr_hi ?? null,
      evidence: c.evidence ? (EVIDENCE[c.evidence] ?? c.evidence) : null,
      pDecrease: c.p_decrease ?? null,
      size: c.size ?? null,
      nBefore: c.n_before ?? null,
      nAfter: c.n_after ?? null,
      mdePct: c.mde_pct ?? null,
      sourceTitle: c.source_doc_title ?? c.source_doc ?? '',
      sourceUrl: c.source_url ?? null,
      sourcePage: c.source_page ?? null,
      description: c.description ?? '',
      plainReading: c.plain_reading ?? null,
    };
  });
---
<Base title="Past checks" description="Every dated inspection, notice and repair on record, with the measured change that followed it." kind="checks">
  <h1>Past checks</h1>
  <p class="lede">One row per dated record at a landfill. The change is what the satellite record shows after that date, compared with control sites, with its 90% range. It is a screening indication that followed the date, never a cause. Colour never stands alone: every result has an icon and a label.</p>
  {rows.length ? (
    <ChecksTable client:load rows={rows} />
  ) : (
    <EmptyState title="No checks on record yet" expected={EXPECTED.checks} />
  )}
  <p class="muted">"Smallest drop the test could see" is the smallest drop this site's own passes would have caught 80% of the time; a real drop below it could have been missed. Terms are explained in <a href="/how-to-read/">How to read this site</a>.</p>
</Base>
