---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BayHero from '../components/BayHero.astro';
import EmptyState from '../components/EmptyState.astro';
import Carousel, { type Slide } from '../islands/Carousel';
import Counter from '../islands/Counter';
import { EXPECTED, RESULT, SITE_NAME, type ResultColour } from '../config';
import { currentUpdates, estimateFor, hasPublication, latestCheckFor, publication, sites, totals } from '../lib/data';
import { date, num } from '../lib/format';
import imagery from '../assets/imagery/imagery.json';

// Aerial close-ups, one per landfill, made by scripts/make-imagery.py.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/imagery/*.jpg', { eager: true });
const photoFor = (id: string) => photos[`../assets/imagery/${id}.jpg`]?.default;

const STEPS: Slide[] = [
  { art: 'pass', title: 'A satellite passes over', text: 'EMIT, Tanager-1, aircraft and Sentinel-2 each look down on their own schedule.' },
  { art: 'plume', title: 'It sees a plume, or not', text: 'Most passes see none. That counts too.' },
  { art: 'count', title: 'Every pass is kept', text: 'So a site seen often is not mistaken for a site that leaks often.' },
  { art: 'range', title: 'A 90% range per site', text: 'How often each site was emitting, and how much.' },
  { art: 'controls', title: 'Control sites', text: 'A shift that hits every landfill at once is not credited to a repair.' },
  { art: 'report', title: 'Set beside EPA reports', text: 'The satellite view next to what each operator reports.' },
];

const landfillSlides: Slide[] = await Promise.all(sites.map(async (s) => {
  const id = s.site_id ?? '';
  const latest = latestCheckFor(id);
  const est = estimateFor(id);
  const colour = latest?.result_held ? 'grey' : (latest?.colour as ResultColour | undefined) ?? 'grey';
  const badge = latest?.result_held ? 'Result held back' : latest?.colour ? RESULT[latest.colour as ResultColour].label : 'Not yet tested';
  const photo = photoFor(id);
  const image = photo
    ? await getImage({ src: photo, widths: [400, 640, 960], format: 'webp', quality: 72 })
    : null;
  return {
    title: s.name ?? id,
    text: `${s.city}, ${s.county} County`,
    // A site the model marks as insufficient data shows no figure, even when a median exists.
    figure: est?.status === 'insufficient_data'
      ? 'Not enough data for an estimate'
      : est && est.e_t_yr_med != null ? `About ${num(est.e_t_yr_med)} t/yr above the floor` : 'No estimate yet',
    href: `/sites/${id}/`,
    colour,
    badge,
    image: image
      ? {
          src: image.src,
          srcset: image.srcSet.attribute,
          sizes: '(min-width: 72rem) 34rem, 46vw',
          width: photo!.width,
          height: photo!.height,
          alt: `Aerial view of ${s.name ?? id}`,
        }
      : undefined,
  };
}));

const LIMITS = [
  { icon: 'sun', text: 'Daytime and clear skies only, about 30 days behind' },
  { icon: 'big', text: 'Sentinel-2 sees only plumes of about 2 t/hr or more' },
  { icon: 'floor', text: 'Annual figures count methane above a detection floor, not a site’s total' },
  { icon: 'near', text: 'Plumes near another source are never assigned to a landfill' },
];
---
<Base title={SITE_NAME} kind="home">
  <section class="hero" aria-labelledby="mission">
    <div class="hero-text">
      <h1 id="mission">How persistently do Bay Area landfills leak methane, and did repairs change that?</h1>
      <p class="lede">Years of public satellite and aircraft passes over five landfills, read back site by site. Every result is a screening indication for investigation.</p>
      <p class="hero-actions">
        <a class="button primary" href="/map/">Open the map</a>
        <a class="button" href="/sites/">See the landfills</a>
      </p>
    </div>
    <BayHero sites={sites} />
  </section>

  {hasPublication ? (
    <>
      <section class="stats reveal" aria-label="In numbers">
        <Counter client:visible value={totals.sites} label="landfills" />
        <Counter client:visible value={totals.usablePasses} label="usable passes" />
        <Counter client:visible value={totals.plumeDays} label="days with a plume" />
        <Counter client:visible value={totals.estimates} label="sites with an estimate" />
      </section>
      <p class="stats-note muted">
        Data through {date(publication?.data_through)}.
        {currentUpdates.length > 0 && <> <a href="/updates/">What changed in this update</a>.</>}
      </p>

      <section class="reveal" aria-labelledby="landfills">
        <h2 id="landfills">The five landfills</h2>
        <Carousel client:visible label="The five landfills" slides={landfillSlides} kind="photos" />
        <p class="credit">Aerial photos: {imagery.credits.sites}</p>
      </section>
    </>
  ) : (
    <EmptyState title="No results yet" expected={EXPECTED.publication}>
      <p>Counts and landfill cards appear here once the first snapshot is published.</p>
    </EmptyState>
  )}

  <section class="reveal" aria-labelledby="method">
    <h2 id="method">How it works</h2>
    <Carousel client:visible label="How it works, step by step" slides={STEPS} kind="steps" />
    <p class="more"><a href="/methods/">The method in full</a></p>
  </section>

  <section class="reveal" aria-labelledby="limits">
    <h2 id="limits">What satellites can't see</h2>
    <ul class="limits">
      {LIMITS.map((l) => (
        <li>
          <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false" fill="none">
            {l.icon === 'sun' && (
              <>
                <circle cx="20" cy="20" r="8" fill="var(--red)" />
                <path d="M20 4v5M20 31v5M4 20h5M31 20h5M8.7 8.7l3.5 3.5M27.8 27.8l3.5 3.5M8.7 31.3l3.5-3.5M27.8 12.2l3.5-3.5" stroke="var(--black)" stroke-width="2" stroke-linecap="round" />
                <path d="M22 40a8 8 0 0 1 8-8 9 9 0 0 1 16 4 5 5 0 0 1-2 9H26a4 4 0 0 1-4-5z" fill="var(--green)" stroke="var(--black)" stroke-width="1.5" />
              </>
            )}
            {l.icon === 'big' && (
              <>
                <circle cx="14" cy="34" r="4" fill="none" stroke="var(--black)" stroke-width="1.5" stroke-dasharray="2 2" />
                <circle cx="31" cy="24" r="13" fill="var(--red)" opacity="0.85" />
                <path d="M4 44h40" stroke="var(--black)" stroke-width="1.5" />
              </>
            )}
            {l.icon === 'floor' && (
              <>
                <rect x="6" y="28" width="36" height="14" fill="var(--green)" />
                <path d="M6 28h36" stroke="var(--black)" stroke-width="2" stroke-dasharray="4 3" />
                <path d="M12 24c4-10 8-14 12-14s8 6 12 14" stroke="var(--red)" stroke-width="3" stroke-linecap="round" />
              </>
            )}
            {l.icon === 'near' && (
              <>
                <rect x="6" y="26" width="12" height="16" fill="var(--green)" stroke="var(--black)" stroke-width="1.5" />
                <rect x="30" y="26" width="12" height="16" fill="var(--white)" stroke="var(--black)" stroke-width="1.5" />
                <circle cx="24" cy="14" r="7" fill="var(--red)" />
                <path d="M21 11l6 6M27 11l-6 6" stroke="var(--white)" stroke-width="2" />
              </>
            )}
          </svg>
          <span>{l.text}</span>
        </li>
      ))}
    </ul>
  </section>

  <script>
    // Scroll reveals. The `js` class gates the hidden state, so pages without JavaScript show everything.
    document.documentElement.classList.add('js');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const targets = document.querySelectorAll<HTMLElement>('.reveal');
    if (reduced || !('IntersectionObserver' in window)) {
      targets.forEach((el) => el.classList.add('is-visible'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      targets.forEach((el) => io.observe(el));
    }
  </script>
</Base>
