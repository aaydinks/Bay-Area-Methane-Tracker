---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BayHero from '../components/BayHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { EXPECTED, SITE_NAME } from '../config';
import { estimateFor, hasPublication, landfillsText, sites, studiedSites, usableEstimate } from '../lib/data';
import { countWord, sentence } from '../lib/format';
import imagery from '../assets/imagery/imagery.json';

// Aerial close-ups, one per landfill, made by scripts/make-imagery.py.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/imagery/*.jpg', { eager: true });
const photoFor = (id: string) => photos[`../assets/imagery/${id}.jpg`]?.default;

// Three steps in everyday words. The terms the other pages use (passes, the detection floor,
// 90% ranges) are explained on How to read and Methods, not here.
const STEPS = [
  { art: 'pass', title: 'Satellites take pictures', text: 'Satellites and aircraft photograph the landfills from above, each on its own schedule.' },
  { art: 'plume', title: 'We look for methane', text: 'Each picture of a landfill is checked for a cloud of methane. Pictures that show none count too.' },
  { art: 'range', title: 'We estimate, with a range', text: 'From all the pictures together, we estimate how often each landfill gave off methane, roughly how much, and how sure we can be.' },
];

// The home cards are the landfills studied in depth; every landfill is on the Landfills page.
// A card carries no figure: a site page shows the estimate with its range and what it leaves
// out. A site marked insufficient data is only ever named as such.
const cards = studiedSites.map((s) => {
  const id = s.site_id ?? '';
  const status = usableEstimate(id)
    ? 'Estimate available'
    : estimateFor(id)?.status === 'insufficient_data' ? 'Not enough data yet' : 'No estimate yet';
  return { id, name: s.name ?? id, place: s.city ?? '', status, photo: photoFor(id) };
});
// Counts and places come from the landfills in this build, never from fixed text.
const others = sites.length - cards.length;
const from = sites.length ? landfillsText(sites.length) : 'landfills';
---
<Base title={SITE_NAME} kind="home">
  <section class="hero" aria-labelledby="mission">
    <div class="hero-text">
      <h1 id="mission" class="hero-title">Bay Area Methane Watch</h1>
      <p class="lede">A look back at what satellites have seen of methane coming from {from}.</p>
      <p class="hero-actions">
        <a class="button primary" href="/sites/">See the landfills</a>
        <a class="quiet-link" href="/map/">or explore the map</a>
      </p>
    </div>
    <BayHero sites={studiedSites} />
  </section>

  <section aria-labelledby="method">
    <h2 id="method">How it works</h2>
    <ol class="steps">
      {STEPS.map((step, i) => (
        <li class="step">
          <svg viewBox="0 0 120 76" aria-hidden="true" focusable="false" fill="none">
            {step.art === 'pass' && (
              <>
                <path d="M8 62 C 40 52, 80 52, 112 62 L 112 72 L 8 72 Z" fill="var(--green)" />
                <path d="M44 16 l14 -6 l6 14 l-14 6 z" fill="var(--black)" />
                <path d="M30 22 l12 -5 l3 7 l-12 5 z M62 9 l12 -5 l3 7 l-12 5 z" fill="var(--red)" />
                <path d="M54 30 L 30 62 M58 30 L 90 62" stroke="var(--black)" stroke-width="1.5" stroke-dasharray="4 4" />
              </>
            )}
            {step.art === 'plume' && (
              <>
                <path d="M8 62 C 40 52, 80 52, 112 62 L 112 72 L 8 72 Z" fill="var(--green)" />
                <rect x="34" y="50" width="20" height="10" rx="2" fill="var(--black)" />
                <path d="M44 50 C 40 40, 52 34, 60 30 C 72 24, 84 26, 96 18" stroke="var(--red)" stroke-width="9" stroke-linecap="round" opacity="0.35" />
                <path d="M44 50 C 40 40, 52 34, 60 30 C 72 24, 84 26, 96 18" stroke="var(--red)" stroke-width="3" stroke-linecap="round" />
              </>
            )}
            {step.art === 'range' && (
              <>
                <path d="M10 60 H 110" stroke="var(--black)" stroke-width="1.5" />
                {[20, 45, 70, 95].map((x) => <path d={`M${x} 56 V 64`} stroke="var(--black)" stroke-width="1.5" />)}
                <rect x="28" y="30" width="62" height="14" rx="7" fill="var(--green)" />
                <path d="M28 37 H 90" stroke="var(--black)" stroke-width="2" />
                <circle cx="56" cy="37" r="7" fill="var(--red)" stroke="var(--white)" stroke-width="2" />
              </>
            )}
          </svg>
          <h3><span class="step-number" aria-hidden="true">{i + 1}</span>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
    <p class="more"><a href="/how-to-read/">How to read the results</a> · <a href="/methods/">The method in full</a></p>
  </section>

  {hasPublication ? (
    <section aria-labelledby="landfills">
      <h2 id="landfills">{cards.length ? `The ${countWord(cards.length)} landfills studied in depth` : 'The landfills'}</h2>
      <ul class="site-cards">
        {cards.map((c) => (
          <li class="site-card">
            {c.photo && (
              <Image src={c.photo} alt="" widths={[320, 480, 640]} sizes="(min-width: 72rem) 13rem, (min-width: 40rem) 30vw, 45vw" format="webp" quality={72} class="site-card-photo" />
            )}
            <div class="site-card-body">
              <h3><a href={`/sites/${c.id}/`}>{c.name}</a></h3>
              <p class="muted">{c.place}</p>
              <p class="site-card-status">{c.status}</p>
            </div>
          </li>
        ))}
      </ul>
      {others > 0 && (
        <p class="more" data-testid="screened-note">
          {sentence(countWord(others))} more {others === 1 ? 'landfill is' : 'landfills are'} screened with the same public data.
          {' '}<a href="/sites/">See all {countWord(sites.length)} landfills</a>
        </p>
      )}
      {cards.some((c) => c.photo) && <p class="credit">Aerial photos: {imagery.credits.sites}</p>}
    </section>
  ) : (
    <EmptyState title="No results yet" expected={EXPECTED.publication}>
      <p>The landfills appear here once the first data update is published.</p>
    </EmptyState>
  )}
</Base>
