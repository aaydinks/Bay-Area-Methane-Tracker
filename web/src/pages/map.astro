---
import '../styles/map.css';
import Base from '../layouts/Base.astro';
import EmptyState from '../components/EmptyState.astro';
import ResultBadge from '../components/ResultBadge.astro';
import TableWrap from '../components/TableWrap.astro';
import MapLoader from '../islands/MapLoader';
import type { SiteSummary } from '../islands/MethaneMap';
import { CHECK_TYPE, EXPECTED, RESULT, type ResultColour } from '../config';
import { estimateFor, hasPublication, latestCheckFor, plumeDaysFor, sites, snapshot, totals, usableEstimate } from '../lib/data';
import { num } from '../lib/format';

const summaries: SiteSummary[] = sites
  .filter((s) => s.lon != null && s.lat != null)
  .map((s) => {
    const id = s.site_id ?? '';
    const pd = plumeDaysFor(id);
    const est = estimateFor(id);
    const usable = usableEstimate(id);
    const latest = latestCheckFor(id);
    const colour = (latest?.colour ?? 'grey') as ResultColour;
    return {
      site_id: id,
      name: s.name ?? id,
      href: `/sites/${id}/`,
      lon: s.lon as number,
      lat: s.lat as number,
      provisional: Boolean(s.provisional),
      status: s.status ?? null,
      usable_passes: pd?.usable_passes ?? 0,
      plume_days: pd?.plume_days ?? 0,
      plume_days_per_usable_pass: pd?.plume_days_per_usable_pass ?? null,
      estimate: usable ? { med: usable.e_t_yr_med, lo: usable.e_t_yr_lo ?? usable.e_t_yr_med, hi: usable.e_t_yr_hi ?? usable.e_t_yr_med } : null,
      estimate_status: est?.status ?? null,
      latest: latest
        ? {
            colour,
            label: RESULT[colour]?.label ?? 'Not yet tested',
            icon: CHECK_TYPE[latest.check_type ?? 'other']?.icon ?? 'dot',
            type_label: CHECK_TYPE[latest.check_type ?? 'other']?.label ?? 'Record',
            held: Boolean(latest.result_held),
          }
        : null,
    };
  });
const availableSources = [...new Set(snapshot.plumes.map((p) => p.source).filter(Boolean))] as string[];
---
<Base title="Map" description="Where satellites and aircraft saw methane plumes near Bay Area landfills, month by month." kind="map">
  <h1>Map</h1>
  <p class="lede">Each red dot is a methane plume that a satellite or aircraft saw near a landfill. Press play to step through them month by month.</p>
  {hasPublication ? (
    <MapLoader client:only="react" sites={summaries} availableSources={availableSources} />
  ) : (
    <EmptyState title="No passes or plumes yet" expected={EXPECTED.plumes} />
  )}
  <details class="more" id="about-map">
    <summary>About this map</summary>
    <p>Plumes are shown where they started, as dots and as a heat map. The grey ring at each landfill grows with the number of usable passes: times a satellite or aircraft had a clear look at the site. Read the dots against those passes, since a site that was observed more often has more chances to show a plume.</p>
    <p>The marker at each landfill shows the latest dated record there. Its shape gives the type of record and its colour only the statistical result; grey means no check on record. Plumes near another methane source are drawn as open circles and never assigned to the landfill.</p>
    <p>This map is a screening indication of where to look, not a finding about any site. Basemap: OpenFreeMap, data from OpenStreetMap contributors.</p>
  </details>
  <details class="more" id="table-view">
  <summary>Table view: the same figures for each landfill</summary>
  {hasPublication ? (
    <TableWrap label="Passes and plume days per landfill">
      <table>
        <caption>Passes and plume days per landfill, {num(totals.plumes)} plume origins in total. Plume days per usable pass corrects for how often a site was observed.</caption>
        <thead>
          <tr>
            <th scope="col">Landfill</th>
            <th scope="col" class="num">Usable passes</th>
            <th scope="col" class="num">Plume days</th>
            <th scope="col" class="num">Plume days per usable pass</th>
            <th scope="col">Outline</th>
            <th scope="col">Latest check</th>
          </tr>
        </thead>
        <tbody>
          {sites.map((s) => {
            const pd = plumeDaysFor(s.site_id ?? '');
            const latest = latestCheckFor(s.site_id ?? '');
            return (
              <tr>
                <th scope="row"><a href={`/sites/${s.site_id}/`}>{s.name}</a></th>
                <td class="num">{num(pd?.usable_passes)}</td>
                <td class="num">{num(pd?.plume_days)}</td>
                <td class="num">{pd?.plume_days_per_usable_pass == null ? '–' : pd.plume_days_per_usable_pass.toFixed(3)}</td>
                <td>{s.provisional ? 'provisional outline' : 'traced outline'}</td>
                <td><ResultBadge colour={latest?.colour} held={latest?.result_held} /></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </TableWrap>
  ) : (
    <p class="muted">The table appears with the first published data update.</p>
  )}
  </details>
</Base>
