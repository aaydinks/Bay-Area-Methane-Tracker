---
import '../styles/map.css';
import Base from '../layouts/Base.astro';
import EmptyState from '../components/EmptyState.astro';
import ResultBadge from '../components/ResultBadge.astro';
import TableWrap from '../components/TableWrap.astro';
import MapLoader from '../islands/MapLoader';
import type { SiteSummary } from '../islands/MethaneMap';
import { CHECK_TYPE, EXPECTED, RESULT, type ResultColour } from '../config';
import { estimateFor, hasPublication, isPublic, latestCheckFor, plumeDaysFor, publication, sites, snapshot, totals } from '../lib/data';
import { num } from '../lib/format';

const summaries: SiteSummary[] = sites
  .filter((s) => s.lon != null && s.lat != null)
  .map((s) => {
    const id = s.site_id ?? '';
    const pd = plumeDaysFor(id);
    const est = estimateFor(id);
    const latest = latestCheckFor(id);
    const colour = (latest?.colour ?? 'grey') as ResultColour;
    return {
      site_id: id,
      name: s.name ?? id,
      href: `/sites/${id}/`,
      lon: s.lon as number,
      lat: s.lat as number,
      provisional: Boolean(s.provisional),
      status: s.status ?? null,
      usable_passes: pd?.usable_passes ?? 0,
      plume_days: pd?.plume_days ?? 0,
      plume_days_per_usable_pass: pd?.plume_days_per_usable_pass ?? null,
      estimate: est && est.e_t_yr_med != null ? { med: est.e_t_yr_med, lo: est.e_t_yr_lo ?? est.e_t_yr_med, hi: est.e_t_yr_hi ?? est.e_t_yr_med } : null,
      estimate_status: est?.status ?? null,
      latest: latest
        ? {
            colour,
            label: RESULT[colour]?.label ?? 'Not yet tested',
            icon: CHECK_TYPE[latest.check_type ?? 'other']?.icon ?? 'dot',
            type_label: CHECK_TYPE[latest.check_type ?? 'other']?.label ?? 'Record',
            held: Boolean(latest.result_held),
          }
        : null,
    };
  });
const availableSources = [...new Set(snapshot.plumes.map((p) => p.source).filter(Boolean))] as string[];
---
<Base title="Map" description="Where plumes were seen, how often each landfill was observed, and the latest check at each site." kind="map">
  <h1>Map</h1>
  <p class="lede">Plume origins as a heat map, passes per site, outlines and the latest check at each landfill, as a screening indication of where to look. Marker shape shows the type of record; colour shows only the statistical result; grey means no check on record. The table below holds the same figures.</p>
  {isPublic && <p class="muted">On the public site, counts cover NASA EMIT and Sentinel-2 until Carbon Mapper confirms its publication terms.</p>}
  {hasPublication ? (
    <MapLoader client:only="react" sites={summaries} isPublic={isPublic} dataThrough={publication?.data_through ?? null} availableSources={availableSources} />
  ) : (
    <EmptyState title="No passes or plumes yet" expected={EXPECTED.plumes} />
  )}
  <h2 id="table-view">Table view</h2>
  {hasPublication ? (
    <TableWrap label="Passes and plume days per landfill">
      <table>
        <caption>Passes and plume days per landfill, {num(totals.plumes)} plume origins in total. Plume days per usable pass corrects for how often a site was observed.</caption>
        <thead>
          <tr>
            <th scope="col">Landfill</th>
            <th scope="col" class="num">Usable passes</th>
            <th scope="col" class="num">Plume days</th>
            <th scope="col" class="num">Plume days per usable pass</th>
            <th scope="col">Outline</th>
            <th scope="col">Latest check</th>
          </tr>
        </thead>
        <tbody>
          {sites.map((s) => {
            const pd = plumeDaysFor(s.site_id ?? '');
            const latest = latestCheckFor(s.site_id ?? '');
            return (
              <tr>
                <th scope="row"><a href={`/sites/${s.site_id}/`}>{s.name}</a></th>
                <td class="num">{num(pd?.usable_passes)}</td>
                <td class="num">{num(pd?.plume_days)}</td>
                <td class="num">{pd?.plume_days_per_usable_pass == null ? '–' : pd.plume_days_per_usable_pass.toFixed(3)}</td>
                <td>{s.provisional ? 'provisional outline' : 'traced outline'}</td>
                <td><ResultBadge colour={latest?.colour} held={latest?.result_held} /></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </TableWrap>
  ) : (
    <p class="muted">The table appears with the first published data update.</p>
  )}
  <p class="muted">Basemap: OpenFreeMap, data from OpenStreetMap contributors.</p>
</Base>
