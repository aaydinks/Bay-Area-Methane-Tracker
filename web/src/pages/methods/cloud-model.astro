---
import '../../styles/charts.css';
import Base from '../../layouts/Base.astro';
import BandChangeChart from '../../components/BandChangeChart.astro';
import EmptyState from '../../components/EmptyState.astro';
import RateChart from '../../components/RateChart.astro';
import TableWrap from '../../components/TableWrap.astro';
import { snapshot, type ValidationResult } from '../../lib/data';
import { date, num } from '../../lib/format';

// The two pre-registered claims of ADR 0013, each one method-check row from reports/validation.
type Triple = [number | null, number | null, number | null] | null;
type Rates = Record<string, Record<string, Triple>>;
type Comparisons = Record<string, Record<string, Triple | boolean>>;
interface ClaimMetrics {
  n_patches?: number; n_sites?: number; n_truly_unusable?: number; n_tile_rule_scored?: number;
  n_targets?: number; n_plumes?: number; amplitude?: number;
  rates: Rates; comparisons: Comparisons;
  west_coast?: { rates: Rates; n_patches?: number; n_sites?: number };
  reference?: { rates?: Rates; n_patches?: number } & Rates;
  band_means?: { bands: string[]; clear: number[]; cloud: number[]; shadow: number[] } | null;
  bay_area?: { site: string; date: string; true_clear: number; clear_model: number; clear_sen2cor: number; clear_s2cloudless: number; tile_cloud_cover: number | null }[];
}

const latest = (gate: string): (ValidationResult & { m: ClaimMetrics }) | undefined =>
  snapshot.validation_results
    .filter((r) => r.gate === gate && !r.superseded)
    .sort((a, b) => (b.created_at ?? '').localeCompare(a.created_at ?? ''))
    .map((r) => ({ ...r, m: r.metrics as unknown as ClaimMetrics }))[0];
const usable = latest('s2_cloud_usable');
const detections = latest('s2_cloud_detections');

// The check on 2025 landfill passes (ADR 0014): one row, written after the blind look by eye.
interface Crit { value?: number | null; interval?: [number | null, number | null]; limit?: number; passed: boolean; n_windows?: number }
interface RecentMetrics {
  windows: { site_days: number; acquisition_days: number; scored: number };
  criteria: {
    '1_scale': { water_b12_median: number; limits: [number, number]; passed: boolean };
    '2_clear_kept': Crit; '3_cloudy_rejected': Crit; '4_platform': Crit;
    '5_false_clouds': { passed: boolean; sites: Record<string, { n_clear_days: number; area_share_flagged: number; site_share_flagged: number; passed: boolean }> };
    '6_eye': { passed: boolean; disagreements: number; model_matches_eye: number; sen2cor_matches_eye: number; agreements: number; agreements_against_eye: number };
  };
}
const recentRow = snapshot.validation_results
  .filter((r) => r.gate === 's2_cloud_recent' && !r.superseded)
  .sort((a, b) => (b.created_at ?? '').localeCompare(a.created_at ?? ''))[0];
const recent = recentRow ? { ...recentRow, m: recentRow.metrics as unknown as RecentMetrics } : undefined;
const recentFailed = recent?.result === 'fail';
const SITE_NAMES: Record<string, string> = {
  'acme-fill': 'Acme Fill', 'newby-island': 'Newby Island', 'potrero-hills': 'Potrero Hills', shoreline: 'Shoreline', 'sonoma-central': 'Sonoma Central',
};
const yesNo = (b: boolean | undefined) => (b === undefined ? '–' : b ? 'Yes' : 'No');

const NAMES: Record<string, string> = {
  tile_rule: 'Whole-tile cloud figure (used until November 2026)',
  threshold: 'Brightness rule (used now in the retrieval)',
  sen2cor: 'Sen2Cor scene classification (used from November 2026)',
  s2cloudless: 's2cloudless',
  model: 'Cloud model',
  unetmobv2_v2: 'UNetMobV2-V2 (reference)',
  none: 'No cloud mask (reference)',
};
const ORDER1 = ['tile_rule', 'threshold', 'sen2cor', 's2cloudless', 'model'];
const ORDER2 = ['none', 'threshold', 'sen2cor', 's2cloudless', 'model'];

const pct = (v: number | null | undefined, d = 1) => (v === null || v === undefined ? '–' : `${(v * 100).toFixed(d)}%`);
const pctRange = (t: Triple) => (t && t[0] !== null ? `${pct(t[0])} (90% range ${pct(t[1])} to ${pct(t[2])})` : '–');
const pts = (v: number | null | undefined) => (v === null || v === undefined ? '–' : `${v > 0 ? '+' : ''}${(v * 100).toFixed(1)}`);
const ptsRange = (t: Triple | boolean | undefined) =>
  Array.isArray(t) && t[0] !== null ? `${pts(t[0])} points (90% range ${pts(t[1])} to ${pts(t[2])})` : '–';
const countRange = (t: Triple) => (t && t[0] !== null ? `${num(t[0], 2)} (90% range ${num(t[1], 2)} to ${num(t[2], 2)})` : '–');
const diffRange = (t: Triple | boolean | undefined) =>
  Array.isArray(t) && t[0] !== null ? `${t[0] > 0 ? '+' : ''}${num(t[0], 2)} (90% range ${num(t[1], 2)} to ${num(t[2], 2)})` : '–';
const passedText = (c: Comparisons[string] | undefined) => (c ? (c.passed ? 'Yes' : 'No') : '–');

const chartItems = (rates: Rates, order: string[], key: string) =>
  order
    .filter((m) => rates[m]?.[key]?.[0] !== null && rates[m]?.[key] !== undefined)
    .map((m) => {
      const t = rates[m][key] as [number, number, number];
      return { label: NAMES[m] ?? m, value: t[0], lo: t[1], hi: t[2], highlight: m === 'model' };
    });
const verdict = (r: ValidationResult | undefined) => (r?.result === 'pass' ? 'Passed' : 'Did not pass');
const call = (share: number | null | undefined) => (share === null || share === undefined ? '–' : share >= 0.7 ? 'usable' : 'not usable');
const tileCall = (cc: number | null | undefined) => (cc === null || cc === undefined ? '–' : cc <= 30 ? 'usable' : 'not usable');
const isoDay = (d: string) => `${d.slice(0, 4)}-${d.slice(4, 6)}-${d.slice(6, 8)}`;
const ref1 = usable?.m.reference?.rates;
---
<Base title="Telling clouds from methane plumes" description="How the Sentinel-2 cloud model separates clouds from methane plumes, how it was tested on images it never saw, and how well it did." kind="methods">
  <p class="muted"><a href="/methods/">Methods and validation</a> › Cloud model</p>
  <h1>Telling clouds from methane plumes in Sentinel-2</h1>
  <p class="lede">Clouds and their shadows can look like methane plumes to the Sentinel-2 method, and they decide which satellite passes count. This page explains the small model built to recognise them and shows, on images it never saw, whether it does better than what the project used before. It is a method check; every site result remains a screening indication for investigation.</p>

  <section aria-labelledby="why">
    <h2 id="why">Why clouds matter</h2>
    <ul>
      <li><strong>False plumes.</strong> The method compares two infrared bands (11 and 12) on the day of interest with a clear earlier day. A cloud, its edge or its shadow on either day changes that comparison and can leave a plume-shaped signal.</li>
      <li><strong>Passes set aside, or wrongly kept.</strong> A pass counts as usable for a site only when at least 70% of the view is clear. Until November 2026 that was judged from the cloud figure for the whole Sentinel-2 tile, about 110 km across, not the 5 to 6 km around the landfill. It is now judged from Sen2Cor's scene classification of the 5 km around each landfill.</li>
      <li><strong>Why the second error matters most.</strong> A cloudy pass counted as usable looks like a day with no large leak, which would make a site seem cleaner than it is.</li>
    </ul>
  </section>

  <section aria-labelledby="how">
    <h2 id="how">How the model tells them apart</h2>
    <p>Methane absorbs sunlight in band 12 and very little anywhere else Sentinel-2 measures. Clouds brighten every band, most of all the cirrus band (band 10); shadows darken every band except band 10, which sees only high in the atmosphere. The model reads all 13 bands of each 20 m pixel, a few band ratios, and how bright and varied the neighbourhood is, then labels the pixel clear, cloud or cloud shadow. It never labels anything a plume: a plume is left alone because it changes only band 12, and the test checks that this holds.</p>
    {usable?.m.band_means && detections?.m.amplitude ? (
      <BandChangeChart
        bands={usable.m.band_means.bands}
        clear={usable.m.band_means.clear}
        cloud={usable.m.band_means.cloud}
        shadow={usable.m.band_means.shadow}
        absorption={detections.m.amplitude}
      />
    ) : (
      <EmptyState title="No band comparison yet" expected="The comparison of clouds, shadows and plumes appears with the held-out test results." />
    )}
    <p>The model is a set of decision trees (gradient boosting), chosen as the smallest kind of model that could beat fixed brightness rules. It was trained only on CloudSEN12+, a public-domain collection of Sentinel-2 images in which experts outlined clouds and shadows by hand. No Carbon Mapper data and no landfill images were used to train or test it.</p>
  </section>

  <section aria-labelledby="test">
    <h2 id="test">How it was tested</h2>
    <ul>
      <li><strong>Written down first.</strong> The test, the comparisons and the pass rules were fixed in decision record 0013 before any result was computed. The test ran once.</li>
      <li><strong>Images it never saw.</strong> Expert-labelled patches of about 5 km from the dataset's own test sites and from every site on the US West Coast, including three in the Bay Area. All dates of a site stay on the same side of the split, and training images from the same Sentinel-2 tiles were removed.</li>
      <li><strong>Compared with:</strong> the whole-tile cloud figure, the brightness rule in the current retrieval, the Sen2Cor scene classification that ships with processed Sentinel-2 images, and s2cloudless, a widely used published cloud model. A deep network from the dataset's authors is shown for reference only.</li>
      <li><strong>Pass rules.</strong> For each comparison, the whole 90% range of the difference must favour the model. The model must also not give up more than 5 percentage points of truly clear passes (result 1) or 2 points of simulated plumes found (result 2).</li>
    </ul>
  </section>

  <section aria-labelledby="usable">
    <h2 id="usable">Result 1: cloudy views counted as usable</h2>
    {usable ? (
      <>
        <p><span class="tag">{verdict(usable)}</span> Held-out test run <span class="mono">{usable.run_id}</span>, {date(usable.created_at)}. {usable.m.n_patches} patches at {usable.m.n_sites} sites, {usable.m.n_truly_unusable} of them truly too cloudy to use.</p>
        <RateChart items={chartItems(usable.m.rates, ORDER1, 'false_usable')} unit="percent" title="Share of too-cloudy views each method called usable (lower is better)" />
        <TableWrap label="Usable views by method">
          <table>
            <caption>Error rates on held-out patches. False-usable: a too-cloudy view counted as usable. False-unusable: a clear view thrown away.</caption>
            <thead><tr><th scope="col">Method</th><th scope="col">False-usable</th><th scope="col">False-unusable</th><th scope="col">Model minus method, false-usable</th><th scope="col">Model minus method, false-unusable</th><th scope="col">Model passes against it</th></tr></thead>
            <tbody>
              {ORDER1.filter((m) => usable.m.rates[m]).map((m) => (
                <tr>
                  <th scope="row">{NAMES[m]}</th>
                  <td>{pctRange(usable.m.rates[m].false_usable)}</td>
                  <td>{pctRange(usable.m.rates[m].false_unusable)}</td>
                  <td>{m === 'model' ? '' : ptsRange(usable.m.comparisons[m]?.false_usable_diff)}</td>
                  <td>{m === 'model' ? '' : ptsRange(usable.m.comparisons[m]?.false_unusable_diff)}</td>
                  <td>{m === 'model' ? '' : passedText(usable.m.comparisons[m])}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </TableWrap>
        {usable.m.n_tile_rule_scored !== undefined && <p class="muted">The whole-tile figure was found for {usable.m.n_tile_rule_scored} of the {usable.m.n_patches} patches; it is scored on those only.</p>}
        {usable.m.west_coast && (
          <p>On the West Coast patches alone, the model called {pct(usable.m.west_coast.rates.model?.false_usable?.[0])} of too-cloudy views usable, against {pct(usable.m.west_coast.rates.sen2cor?.false_usable?.[0])} for Sen2Cor and {pct(usable.m.west_coast.rates.s2cloudless?.false_usable?.[0])} for s2cloudless.</p>
        )}
        {ref1?.unetmobv2_v2 && (
          <p><strong>A larger model does better.</strong> On the dataset's own test sites, the deep network from the dataset's authors (UNetMobV2-V2) called {pct(ref1.unetmobv2_v2.false_usable?.[0])} of too-cloudy views usable and threw away {pct(ref1.unetmobv2_v2.false_unusable?.[0])} of clear ones, against {pct(ref1.model?.false_usable?.[0])} and {pct(ref1.model?.false_unusable?.[0])} for this model. It was a reference, not one of the pre-registered comparisons, and it needs a deep-learning library to run.</p>
        )}
        {usable.m.bay_area && usable.m.bay_area.length > 0 && (
          <TableWrap label="Bay Area test patches">
            <table>
              <caption>The {usable.m.bay_area.length} held-out patches in the Bay Area (three sites near San Jose and the North Bay, not landfills): too few to test on their own. A view is usable when at least 70% of it is clear.</caption>
              <thead><tr><th scope="col">Site and date</th><th scope="col">Expert labels</th><th scope="col">Cloud model</th><th scope="col">Sen2Cor</th><th scope="col">s2cloudless</th><th scope="col">Whole-tile figure</th></tr></thead>
              <tbody>
                {usable.m.bay_area.map((b) => (
                  <tr>
                    <th scope="row"><span class="mono">{b.site}</span>, {isoDay(b.date)}</th>
                    <td>{call(b.true_clear)} ({pct(b.true_clear, 0)} clear)</td>
                    <td>{call(b.clear_model)}</td>
                    <td>{call(b.clear_sen2cor)}</td>
                    <td>{call(b.clear_s2cloudless)}</td>
                    <td>{tileCall(b.tile_cloud_cover)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </TableWrap>
        )}
      </>
    ) : (
      <EmptyState title="Not yet tested" expected="The held-out test results appear here once the test has run." />
    )}
  </section>

  <section aria-labelledby="detections">
    <h2 id="detections">Result 2: false detections caused by clouds</h2>
    {detections ? (
      <>
        <p><span class="tag">{verdict(detections)}</span> {detections.m.n_targets} cloudy or clear target days at {detections.m.n_sites} sites, each compared with that site's clearest day. {detections.m.n_plumes} simulated plumes were added to check that masking clouds does not hide plumes.</p>
        <RateChart items={chartItems(detections.m.rates, ORDER2, 'cloud_caused_per_target')} unit="count" title="Cloud-caused false detections per day (lower is better)" />
        <TableWrap label="Cloud-caused detections by method">
          <table>
            <caption>Candidates from the Sentinel-2 detection step that sit mostly on labelled cloud or shadow, and the share of simulated plumes still found.</caption>
            <thead><tr><th scope="col">Method</th><th scope="col">Cloud-caused per day</th><th scope="col">Simulated plumes found</th><th scope="col">Model minus method, per day</th><th scope="col">Model minus method, plumes found</th><th scope="col">Model passes against it</th></tr></thead>
            <tbody>
              {ORDER2.filter((m) => detections.m.rates[m]).map((m) => (
                <tr>
                  <th scope="row">{NAMES[m]}</th>
                  <td>{countRange(detections.m.rates[m].cloud_caused_per_target)}</td>
                  <td>{pctRange(detections.m.rates[m].detection_share)}</td>
                  <td>{m === 'model' || m === 'none' ? '' : diffRange(detections.m.comparisons[m]?.cloud_caused_diff)}</td>
                  <td>{m === 'model' || m === 'none' ? '' : ptsRange(detections.m.comparisons[m]?.detection_share_diff)}</td>
                  <td>{m === 'model' || m === 'none' ? '' : passedText(detections.m.comparisons[m])}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </TableWrap>
        <p class="muted">Simulated plumes are measured as the share of light absorbed in band 12 at their centre ({pct(detections.m.amplitude, 0)}), chosen beforehand on separate validation images. Converting that to tonnes per hour needs a table the project does not have yet.</p>
      </>
    ) : (
      <EmptyState title="Not yet tested" expected="The held-out test results appear here once the test has run." />
    )}
  </section>

  <section aria-labelledby="recent">
    <h2 id="recent">Checked on recent landfill passes</h2>
    {recent ? (
      <>
        <p><span class="tag">{recent.result === 'pass' ? 'Passed' : 'Did not pass'}</span> Check run <span class="mono">{recent.run_id}</span>, {date(recent.created_at)}. Every Sentinel-2 pass over the five landfills in 2025: {recent.m.windows.site_days} site-days on {recent.m.windows.acquisition_days} days, {recent.m.windows.scored} of them scored over the 5 km around each site. The test images were all from 2017 to 2020, so this asks whether the model behaves the same on newer images, including the Sentinel-2C satellite. There are no expert labels for these passes, so Sen2Cor and a blind look by eye are the yardsticks. The six rules were written down before the run (decision record 0014).</p>
        <TableWrap label="Recent-pass check">
          <table>
            <caption>The six rules of the recent-pass check. All six had to hold.</caption>
            <thead><tr><th scope="col">Rule</th><th scope="col">Result</th><th scope="col">Limit</th><th scope="col">Held</th></tr></thead>
            <tbody>
              <tr><th scope="row">Brightness scale matches the training images (band 12 over water on clear days)</th><td>{num(recent.m.criteria['1_scale'].water_b12_median, 3)}</td><td>{recent.m.criteria['1_scale'].limits[0]} to {recent.m.criteria['1_scale'].limits[1]}</td><td>{yesNo(recent.m.criteria['1_scale'].passed)}</td></tr>
              <tr><th scope="row">Clear views (Sen2Cor at least 99% clear) the model threw away</th><td>{pct(recent.m.criteria['2_clear_kept'].value)} of {recent.m.criteria['2_clear_kept'].n_windows} (90% range {pct(recent.m.criteria['2_clear_kept'].interval?.[0])} to {pct(recent.m.criteria['2_clear_kept'].interval?.[1])})</td><td>at most {pct(recent.m.criteria['2_clear_kept'].limit)}</td><td>{yesNo(recent.m.criteria['2_clear_kept'].passed)}</td></tr>
              <tr><th scope="row">Cloudy views (Sen2Cor under 30% clear) the model kept</th><td>{pct(recent.m.criteria['3_cloudy_rejected'].value)} of {recent.m.criteria['3_cloudy_rejected'].n_windows} (90% range {pct(recent.m.criteria['3_cloudy_rejected'].interval?.[0])} to {pct(recent.m.criteria['3_cloudy_rejected'].interval?.[1])})</td><td>at most {pct(recent.m.criteria['3_cloudy_rejected'].limit)}</td><td>{yesNo(recent.m.criteria['3_cloudy_rejected'].passed)}</td></tr>
              <tr><th scope="row">Sentinel-2C treated like 2A and 2B (difference in clear share against Sen2Cor)</th><td>{pts(recent.m.criteria['4_platform'].value)} points (90% range {pts(recent.m.criteria['4_platform'].interval?.[0])} to {pts(recent.m.criteria['4_platform'].interval?.[1])})</td><td>within ±{Math.round((recent.m.criteria['4_platform'].limit ?? 0) * 100)} points</td><td>{yesNo(recent.m.criteria['4_platform'].passed)}</td></tr>
              <tr><th scope="row">No fixed false clouds: the same pixels called cloud or shadow on more than 20% of clear days</th><td>see below</td><td>at most 1% of the 5 km area and 5% of the site circle, at every site</td><td>{yesNo(recent.m.criteria['5_false_clouds'].passed)}</td></tr>
              <tr><th scope="row">Blind look by eye at {recent.m.criteria['6_eye'].disagreements + recent.m.criteria['6_eye'].agreements} views</th><td>where the model and Sen2Cor disagreed, the eye sided with the model {recent.m.criteria['6_eye'].model_matches_eye} times and with Sen2Cor {recent.m.criteria['6_eye'].sen2cor_matches_eye} times; {recent.m.criteria['6_eye'].agreements_against_eye} of {recent.m.criteria['6_eye'].agreements} agreements went against the eye</td><td>model at least as often as Sen2Cor; at most 1 agreement against the eye</td><td>{yesNo(recent.m.criteria['6_eye'].passed)}</td></tr>
            </tbody>
          </table>
        </TableWrap>
        <TableWrap label="Fixed false clouds by site">
          <table>
            <caption>Share of pixels the model called cloud or shadow on more than 20% of the days Sen2Cor saw as clear. The site circle is the provisional 500 m circle around each landfill.</caption>
            <thead><tr><th scope="col">Site</th><th scope="col">Clear days</th><th scope="col">Share of the 5 km area</th><th scope="col">Share of the site circle</th><th scope="col">Held</th></tr></thead>
            <tbody>
              {Object.entries(recent.m.criteria['5_false_clouds'].sites).map(([site, v]) => (
                <tr><th scope="row">{SITE_NAMES[site] ?? site}</th><td>{v.n_clear_days}</td><td>{pct(v.area_share_flagged, 2)}</td><td>{pct(v.site_share_flagged, 2)}</td><td>{yesNo(v.passed)}</td></tr>
              ))}
            </tbody>
          </table>
        </TableWrap>
        {recentFailed && (
          <ul>
            <li><strong>What held.</strong> The newer images and Sentinel-2C caused no problem. The model's calls on clear and cloudy views agreed with Sen2Cor as closely as on the test images.</li>
            <li><strong>What failed.</strong> On clear days the model kept flagging the same places: bright rooftops and parts of the landfills as cloud, and dark ponds as shadow. This seldom changes whether a whole view counts, but the rule written in advance does not allow it, and at Sonoma Central it covers a tenth of the circle around the site.</li>
            <li><strong>Found after the run: the eye could not see thin cirrus.</strong> Where only the model called a view usable, Sen2Cor's reason was mostly thin cirrus, and the cirrus band was 2 to 10 times its clear-day level. Thin cirrus hardly shows in true colour, so the look by eye cannot settle those views, and Sen2Cor may well have been right.</li>
            <li><strong>Found after the run: 16 views left out.</strong> A matching error paired 16 views with an empty Sen2Cor file. With them included, Potrero Hills would have passed the false-cloud rule (0.92% of the area against 1%); the other four sites still fail. The result above is the single run; decision record 0014 gives both sets of numbers and keeps all five sites on Sen2Cor.</li>
          </ul>
        )}
      </>
    ) : (
      <EmptyState title="Not yet checked" expected="The check on recent landfill passes appears here once it has run." />
    )}
  </section>

  <section aria-labelledby="means">
    <h2 id="means">What this means for the site estimates</h2>
    {usable || detections ? (
      <ul>
        <li><strong>Usable passes:</strong> {recentFailed
          ? `the model passed the held-out test but not the check on recent landfill passes, so it does not decide which Sentinel-2 passes count. Sen2Cor's judgement over each site replaces the whole-tile cloud figure instead, as written down before the check. Updates built from 7 November 2026 use it; earlier ones used the whole-tile figure. A pass for which Sen2Cor has no judgement keeps the whole-tile figure. Sen2Cor is better than the whole-tile figure but far from clean: in the held-out test it still counted ${pctRange(usable?.m.rates.sen2cor?.false_usable ?? [null, null, null])} of too-cloudy views as usable.`
          : usable?.result === 'pass'
            ? 'the model passed, so its judgement over each site may replace the whole-tile cloud figure when deciding which Sentinel-2 passes count. That change has not been made yet; until it is, the site pages still use the whole-tile figure. Before it is made, the model needs a check on recent passes over the landfills, because every test image dates from 2017 to 2020.'
            : 'the model did not pass, so it is not used to decide which passes count. A per-site cloud product is used instead of the whole-tile figure once that change is made.'}</li>
        <li><strong>Detections:</strong> {recentFailed
          ? 'the model is not used to mask clouds before Sentinel-2 detection: on clear days it would mask parts of the landfills, which is where a plume starts.'
          : detections?.result === 'pass'
            ? 'the model passed, so it may mask clouds before Sentinel-2 detection. That change has not been made yet either.'
            : 'the model did not pass, so it is not used to mask clouds before Sentinel-2 detection.'}</li>
        <li>Sentinel-2 sees only plumes of about 2 tonnes per hour or more, so it is a check on large events, and any Sentinel-2 detection needs an EMIT or Carbon Mapper plume to back it.</li>
      </ul>
    ) : (
      <p>Nothing changes until the held-out test has run.</p>
    )}
  </section>

  <section aria-labelledby="before">
    <h2 id="before">What changed before the test, and why</h2>
    <ul>
      <li><strong>One correction, found on tuning images.</strong> A rehearsal on separate tuning images showed the first version was too cautious: it threw away 16% of clear views, because it was trained on equal numbers of clear, cloud and shadow examples. Its answers were then re-weighted to the real shares (about 64% clear, 30% cloud and 7% shadow). On the tuning images that brought clear views thrown away down to 7% and raised too-cloudy views counted as usable from 4% to 8%. Nothing else was changed, and the test images were not looked at until the one run.</li>
      <li><strong>The plume part of the test is weak.</strong> The image pairs are months apart, so even with no cloud mask only about a quarter of the simulated plumes were found. The rule for choosing plume strength (find 80% of plumes on clear tuning pairs) was never met, so the strongest pre-set value was used, as written down in advance. Only one tuning site had a clear pair to choose it with.</li>
      <li><strong>The plume result was not robust in rehearsal.</strong> On the tuning images the model found 2 to 5 points fewer simulated plumes than two of the other methods, which would have failed result 2. On the test images it found slightly more. Treat result 2 as a sign that the model does not hide plumes, not as proof.</li>
    </ul>
  </section>

  <section aria-labelledby="limits">
    <h2 id="limits">Limits</h2>
    <ul>
      <li>The test images are from many places, not from Bay Area landfills. Only three test sites are in the Bay Area, too few to test on their own.</li>
      <li>Every training and test image dates from 2017 to 2020 and comes from Sentinel-2A or 2B. The landfill passes since 2022 use newer processing and include Sentinel-2C. {recent ? 'The check on 2025 passes above found no problem from that, but found fixed false clouds over roofs, ponds and parts of the landfills.' : 'The model needs checking on recent passes before it decides which ones count.'}</li>
      <li>The look by eye is one person’s reading of 24 small images; four were close to the 70% line, and reading all four the other way would not change that rule’s result. Thin cirrus cannot be seen in such images.</li>
      <li>The simulated plumes are simple shapes. Real plumes are patchier, and no real Sentinel-2 plume at a Bay Area landfill has yet been confirmed.</li>
      <li>Thin cloud is counted as unusable, which is cautious; some passes under thin cloud might still be usable for large plumes.</li>
      <li>A narrower range for each site's estimate, or a smaller detectable drop in the before/after test, can only be shown in simulation until the first real model fit.</li>
    </ul>
  </section>

