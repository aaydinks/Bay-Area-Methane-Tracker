---
import '../../styles/charts.css';
import TableWrap from '../../components/TableWrap.astro';
import PassTimeline from '../../components/PassTimeline.astro';
import Base from '../../layouts/Base.astro';
import CheckTypeTag from '../../components/CheckTypeTag.astro';
import EmptyState from '../../components/EmptyState.astro';
import Range from '../../components/Range.astro';
import ContextMeasures from '../../components/ContextMeasures.astro';
import ObservedMeasures from '../../components/ObservedMeasures.astro';
import ReportedMeasures from '../../components/ReportedMeasures.astro';
import ResultBadge from '../../components/ResultBadge.astro';
import { DATE_CONFIDENCE, EXPECTED, INSTRUMENT, TIER } from '../../config';
import {
  checksFor, districtLabel, estimateFor, featuresFor, fromScreeningFit, hasContext, hasMeasures, hasObserved, isStudied, modelInstruments, neighboursFor, NOT_SEARCHED,
  operatorReportsFor, passesByInstrument, passMonthsFor, plumeDaysFor, populationFor, regionIds, regionLabel, screeningFit, sites, type Site,
  usableEstimate,
} from '../../lib/data';
import { date, listText, num, pct } from '../../lib/format';

export function getStaticPaths() {
  return sites.map((s) => ({ params: { site: s.site_id ?? '' }, props: { site: s } }));
}
interface Props { site: Site }
const { site } = Astro.props;
const id = site.site_id ?? '';
const estimate = estimateFor(id);
const passes = passesByInstrument(id);
const passMonths = passMonthsFor(id);
const plumeDays = plumeDaysFor(id);
const checks = checksFor(id);
const reports = operatorReportsFor(id);
const residents = populationFor(id);
const neighbours = neighboursFor(id);
const features = featuresFor(id);
// The fit behind this landfill's figure: the update's main fit, or the screening fit for a
// landfill the main fit does not cover (ADR 0021). The page says so when it is the second.
const screening = fromScreeningFit(id) ? screeningFit : null;
// Instruments that fit used, and those with usable passes here that it left out (ADR 0016).
const model = modelInstruments(estimate?.model_run_id ?? undefined);
const label = (i: string) => INSTRUMENT[i] ?? i;
const leftHere = model.leftOut
  .map((l) => ({ ...l, usable: passes.find((p) => p.instrument === l.instrument)?.usable ?? 0 }))
  .filter((l) => l.usable > 0);
const showModel = Boolean(estimate) && model.used.length > 0;
const leftNames = new Set(showModel ? leftHere.map((l) => l.instrument) : []);
// The same rule as the home page and the landfills list: no figure without a usable estimate.
const hasEstimate = Boolean(usableEstimate(id));
// One plain sentence under the title, built from what this update holds for the site.
const plain = hasEstimate && estimate
  ? `A plume was seen in ${num(estimate.n_detections)} of the ${num(estimate.n_usable_overpasses)} clear looks used for the estimate below.`
  : estimate
    ? 'There is not enough data for an estimate yet; the reason is below.'
    : isStudied(site)
      ? 'There is no estimate for this landfill in this update.'
      : 'This landfill is screened: its passes and plumes are counted below, and it has no estimate yet.';
// A screened landfill with no estimate is not one with too little data: no model fit has
// included it yet, and the page says so.
const noEstimate = estimate
  ? { title: 'Insufficient data', text: estimate.insufficient_reason ? `${estimate.insufficient_reason}. ${EXPECTED.estimates}` : EXPECTED.estimates }
  : isStudied(site)
    ? { title: 'No estimate yet', text: EXPECTED.estimates }
    : { title: 'No estimate yet', text: 'This landfill is screened with the same public data as the others, but it is not yet part of a model fit. That says nothing about how much methane it gives off.' };
---
<Base title={site.name ?? id} description={`What satellites and aircraft have seen of methane at ${site.name}, with an estimate and its range.`} kind="site" image={`/og/${id}.png`}>
  <h1>{site.name}</h1>
  <p class="lede">{site.city}, {site.county} County. {plain}</p>

  <section aria-labelledby="estimate">
    <h2 id="estimate">How much methane</h2>
    {hasEstimate && estimate ? (
      <div class="headline-figure">
        <p class="figure"><span class="figure-value">{num(estimate.e_t_yr_med)}</span> <span class="figure-unit">tonnes a year</span></p>
        <p class="figure-range">90% range {num(estimate.e_t_yr_lo)} to {num(estimate.e_t_yr_hi)} tonnes a year{estimate.provisional ? ' · provisional' : ''}</p>
        <p class="muted">Methane above what the instruments can detect, in daytime and clear skies. It is not the landfill's total.</p>
        {screening && (
          <p class="muted" data-testid="screening-fit">
            This figure comes from the screening fit, one model fitted to {screening.pooled ? `all ${num(screening.pooled)} landfills` : 'every landfill'} together. It is provisional, and it is not the fit behind the figures of the landfills studied in depth.
          </p>
        )}
      </div>
    ) : (
      <EmptyState title={noEstimate.title} expected={noEstimate.text} />
    )}
  </section>

  <section aria-labelledby="passes">
    <h2 id="passes">When satellites looked</h2>
    {passes.length ? (
      <>
        <p>How often each instrument had a clear look at the landfill, month by month, and when it saw a plume.</p>
        <PassTimeline rows={passMonths} siteName={site.name ?? id} />
      </>
    ) : (
      <EmptyState title="No passes yet" expected={EXPECTED.plumes} />
    )}
  </section>

  <section aria-labelledby="checks">
    <h2 id="checks">Checks on record</h2>
    {checks.length ? (
      <ul>
        {checks.map((c) => (
          <li>
            {date(c.date_start)} <span class="muted">({DATE_CONFIDENCE[c.date_confidence ?? ''] ?? ''})</span> · <CheckTypeTag type={c.check_type} repairKind={c.repair_kind} siteId={id} /> · <ResultBadge colour={c.colour} held={c.result_held} />
            {c.plain_reading && <p>{c.plain_reading}</p>}
            {!c.plain_reading && c.change_pct_med != null && <p class="muted">Change {pct(c.change_pct_med)} (90% range {pct(c.change_pct_lo)} to {pct(c.change_pct_hi)}); passes before / after {num(c.n_before)} / {num(c.n_after)}.</p>}
          </li>
        ))}
      </ul>
    ) : (
      <EmptyState title="No checks on record for this site" expected={EXPECTED.checks} />
    )}
  </section>

  <section aria-labelledby="details">
    <h2 id="details">Details</h2>
    <details class="more">
      <summary>The estimate in full</summary>
      {hasEstimate && estimate ? (
        <dl class="facts">
          <dt>Annual methane above the floor</dt><dd><Range med={estimate.e_t_yr_med} lo={estimate.e_t_yr_lo} hi={estimate.e_t_yr_hi} unit="t/yr" /></dd>
          <dt>Share of observed times emitting</dt><dd><Range med={estimate.f_med == null ? null : estimate.f_med * 100} lo={estimate.f_lo == null ? null : estimate.f_lo * 100} hi={estimate.f_hi == null ? null : estimate.f_hi * 100} unit="%" /></dd>
          <dt>Typical rate while emitting</dt><dd><Range med={estimate.qbar_kg_hr_med} lo={estimate.qbar_kg_hr_lo} hi={estimate.qbar_kg_hr_hi} unit="kg/hr" /></dd>
          <dt>Passes used</dt><dd>{num(estimate.n_usable_overpasses)} usable, {num(estimate.n_detections)} with a detection</dd>
        </dl>
      ) : (
        <p class="muted">No estimate in this update.</p>
      )}
      {hasEstimate && estimate?.provisional && <p class="muted">Provisional: some detection curves are not yet confirmed.</p>}
      {screening && estimate && <p class="muted">From the screening fit, run <span class="mono">{screening.runId}</span>.</p>}
      {showModel && (
        <p class="muted" data-testid="model-instruments">
          The model run uses {listText(model.used.map(label))}.
          {leftHere.map((l) => l.reason === NOT_SEARCHED
            ? ` ${label(l.instrument)}'s ${num(l.usable)} usable passes are left out: no plume search has run on them yet, and a pass nobody searched is not a pass that saw nothing.`
            : ` ${label(l.instrument)}'s ${num(l.usable)} usable passes are not part of this model run.`)}
        </p>
      )}
    </details>

    {passes.length > 0 && (
      <details class="more">
        <summary>Passes by instrument</summary>
        <TableWrap label="Passes by instrument">
          <table>
            <caption>{plumeDays ? `${num(plumeDays.plume_days)} plume days over ${num(plumeDays.usable_passes)} usable passes.` : ''}</caption>
            <thead><tr><th scope="col">Instrument</th><th scope="col" class="num">Passes</th><th scope="col" class="num">Usable</th><th scope="col" class="num">With a detection</th></tr></thead>
            <tbody>
              {passes.map((p) => (
                <tr><th scope="row">{INSTRUMENT[p.instrument] ?? p.instrument}{leftNames.has(p.instrument) && <span class="muted"> · not in the estimate</span>}</th><td class="num">{num(p.passes)}</td><td class="num">{num(p.usable)}</td><td class="num">{num(p.detected)}</td></tr>
              ))}
            </tbody>
          </table>
        </TableWrap>
      </details>
    )}

    <details class="more" id="operator">
      <summary>Satellite estimate versus operator-reported figures</summary>
      {reports.length ? (
        <TableWrap label="Operator-reported figures">
          <table>
            <caption>Reported figures are published as t CO2e; the factor used to convert them back to tonnes of methane is unconfirmed. The satellite figure is methane above the detection floor in daytime, clear skies, not a total.</caption>
            <thead><tr><th scope="col">Year</th><th scope="col">Source</th><th scope="col" class="num">Reported t CH4</th><th scope="col" class="num">As published, t CO2e</th><th scope="col" class="num">Factor used</th></tr></thead>
            <tbody>
              {reports.map((r) => (
                <tr><th scope="row">{r.year}</th><td><a href={r.url}>{r.source}</a></td><td class="num">{num(r.reported_ch4_t)}</td><td class="num">{num(r.reported_co2e_t)}</td><td class="num">{num(r.gwp_used)}{r.gwp_confirmed ? '' : ' (unconfirmed)'}</td></tr>
              ))}
            </tbody>
          </table>
        </TableWrap>
      ) : (
        <EmptyState title="No operator-reported figures" expected={EXPECTED.operator} />
      )}
    </details>

    {hasMeasures && (
      <details class="more" id="reported">
        <summary>Gases and other figures reported for this landfill</summary>
        <ReportedMeasures siteId={id} />
      </details>
    )}

    {hasObserved && (
      <details class="more" id="observed">
        <summary>CO2 plumes searched for near this landfill</summary>
        <ObservedMeasures siteId={id} />
      </details>
    )}

    {hasContext && (
      <details class="more" id="context">
        <summary>The area around this landfill</summary>
        <ContextMeasures siteId={id} />
      </details>
    )}

    <details class="more">
      <summary>About the site and its surroundings</summary>
      <dl class="facts">
        {site.operator && <><dt>Operator</dt><dd>{site.operator}</dd></>}
        {site.status && <><dt>Status</dt><dd>{site.status}</dd></>}
        {regionIds.length > 1 && site.region && <><dt>Region</dt><dd>{regionLabel(site.region)}</dd></>}
        {site.tier && TIER[site.tier] && <><dt>Coverage</dt><dd>{TIER[site.tier]}</dd></>}
        {site.air_district && (
          <>
            <dt>Air district</dt>
            <dd data-testid="air-district">{districtLabel(site.air_district)}{site.air_district_confirmed ? '' : " (from CARB's 2004 district outlines; not yet checked with the district)"}</dd>
          </>
        )}
        {site.district_facility_id && <><dt>Facility number at the air district</dt><dd>{site.district_facility_id}</dd></>}
        <dt>Outline</dt><dd>{site.provisional ? `Provisional (${site.polygon_source ?? 'placeholder'})` : site.polygon_source ?? 'traced'}</dd>
        {site.swis_number && <><dt>CalRecycle SWIS</dt><dd>{site.swis_number}</dd></>}
        {site.ghgrp_facility_id && <><dt>EPA GHGRP facility</dt><dd>{site.ghgrp_facility_id}</dd></>}
        {features && <><dt>Area</dt><dd>{num(features.area_km2)} km²</dd></>}
      </dl>
      {neighbours.length > 0 && (
        <p>Other methane sources nearby: {neighbours.map((n) => `${n.name} (${n.kind}, ${num(n.distance_m)} m)`).join('; ')}. Plumes near them are marked ambiguous and never assigned to this landfill.</p>
      )}
      {residents.length ? (
        <p>Residents nearby, as context only: {residents.map((r) => `${num(r.residents)} within ${r.radius_km} km`).join(', ')}.</p>
      ) : (
        <p class="muted">Residents nearby appear once the census context is loaded.</p>
      )}
    </details>
  </section>
</Base>
