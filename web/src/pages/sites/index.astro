---
import '../../styles/charts.css';
import '../../styles/sites.css';
import Base from '../../layouts/Base.astro';
import RangeChart from '../../components/RangeChart.astro';
import EmptyState from '../../components/EmptyState.astro';
import SitesTable, { type SiteRow } from '../../islands/SitesTable';
import { EXPECTED } from '../../config';
import {
  estimateFor, fromScreeningFit, hasPublication, isStudied, landfillsText, plumeDaysFor, regionIds, regionLabel, regionsText, screeningFit, sites,
  studiedSites, usableEstimate,
} from '../../lib/data';
import { countWord, sentence } from '../../lib/format';

// Only landfills with a usable estimate are ranked or charted. One the model marks as
// insufficient data shows the reason in place of a figure, even when its row carries a median.
const withEstimate = sites.filter((s) => usableEstimate(s.site_id ?? ''))
  .sort((a, b) => (usableEstimate(b.site_id ?? '')?.e_t_yr_med ?? 0) - (usableEstimate(a.site_id ?? '')?.e_t_yr_med ?? 0));
const chartItems = withEstimate.map((s) => {
  const e = usableEstimate(s.site_id ?? '')!;
  return { label: (s.name ?? '').replace(' Landfill', ''), med: e.e_t_yr_med, lo: e.e_t_yr_lo ?? e.e_t_yr_med, hi: e.e_t_yr_hi ?? e.e_t_yr_med, provisional: Boolean(e.provisional) };
});

const rows: SiteRow[] = sites.map((s) => {
  const id = s.site_id ?? '';
  const usable = usableEstimate(id);
  const any = estimateFor(id);
  const pd = plumeDaysFor(id);
  return {
    id,
    name: s.name ?? id,
    href: `/sites/${id}/`,
    place: [s.city, s.county ? `${s.county} County` : null].filter(Boolean).join(', '),
    county: s.county ?? '',
    region: s.region ?? '',
    regionLabel: regionLabel(s.region),
    studied: isStudied(s),
    usablePasses: pd?.usable_passes ?? null,
    plumeDays: pd?.plume_days ?? null,
    estimate: usable
      ? {
        med: usable.e_t_yr_med, lo: usable.e_t_yr_lo ?? usable.e_t_yr_med, hi: usable.e_t_yr_hi ?? usable.e_t_yr_med,
        provisional: Boolean(usable.provisional), screening: fromScreeningFit(id),
      }
      : null,
    note: any ? 'Not enough data yet' : 'No estimate yet',
    reason: any?.insufficient_reason ?? null,
  };
});
const regions = regionIds.map((id) => ({ id, label: regionLabel(id) }));

const n = sites.length;
const allStudied = studiedSites.length === n;
const where = regionsText ? ` in ${regionsText}` : '';
const lede = allStudied
  ? `The ${countWord(n)} landfills studied in depth${where}, with how much methane satellites and aircraft suggest each one gives off in a year.`
  : `${sentence(landfillsText(n))}: ${countWord(studiedSites.length)} studied in depth, the rest screened with the same public data.`;
const description = n
  ? `${sentence(landfillsText(n))}, with what satellites and aircraft have seen at each one.`
  : 'The landfills this tracker follows, with what satellites and aircraft have seen at each one.';
---
<Base title="Landfills" description={description} kind="sites">
  <h1>Landfills</h1>
  <p class="lede">{n ? lede : 'The landfills this tracker follows appear here with the first data update.'}</p>
  <details class="more">
    <summary>What the estimates mean</summary>
    <p>Each estimate is annual methane above the detection floor in daytime, clear-sky conditions, with its 90% range: a screening indication, not a site's total. A landfill without enough data for an estimate shows the reason in place of a figure and is never ranked.</p>
    {!allStudied && (screeningFit ? (
      <p data-testid="screening-fit-note">A screened landfill has its passes and plumes counted in the same way as the others. Its estimate, where it has one, comes from the screening fit: one model fitted to {screeningFit.pooled ? `all ${countWord(screeningFit.pooled)} landfills` : 'every landfill'} together. Those figures are provisional and marked "screening fit". The landfills studied in depth keep the figures of their own fit.</p>
    ) : (
      <p>A screened landfill has its passes and plumes counted in the same way as the others. It gets an estimate only once it is part of a model fit, so "no estimate yet" says nothing about how much methane it gives off.</p>
    ))}
  </details>
  {hasPublication ? (
    <>
      <section aria-labelledby="ranked">
        <h2 id="ranked">Landfills with an estimate</h2>
        {withEstimate.length ? (
          <>
            <RangeChart items={chartItems} unit="t/yr" title="Annual methane above the floor, by landfill" />
            {screeningFit && <p class="muted" data-testid="chart-fits">Figures for screened landfills come from the screening fit; the table below marks them.</p>}
          </>
        ) : (
          <EmptyState title="No estimates yet" expected={EXPECTED.estimates} />
        )}
      </section>
      <section aria-labelledby="all">
        <h2 id="all">All landfills</h2>
        <SitesTable client:load rows={rows} regions={regions} />
      </section>
    </>
  ) : (
    <EmptyState title="No landfill data yet" expected={EXPECTED.publication} />
  )}
</Base>
